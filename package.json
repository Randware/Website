		"@types/sanitize-html": "^2.16.2",
		"autoprefixer": "^10.6.2",
		"dotenv": "^16.6.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"prettier": "^3.10.1",
